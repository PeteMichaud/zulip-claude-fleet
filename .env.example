# Copy to .env and fill in. .env is gitignored.

# Your Zulip realm
ZULIP_SITE=https://your-realm.zulipchat.com
ZULIP_OWNER_USER_ID=your-numeric-user-id

# dispatch-bot — fleet-ops identity. Must be promoted to Zulip
# organization admin in the realm's user-management UI.
DISPATCH_BOT_EMAIL=dispatch-bot@your-realm.zulipchat.com
DISPATCH_BOT_API_KEY=replace-me
DISPATCH_STREAM=Dispatch

# Owner credentials — your personal user account. Used only by create-bot,
# because Zulip's /bots endpoint refuses bot callers regardless of role.
OWNER_EMAIL=you@example.com
OWNER_API_KEY=replace-me
